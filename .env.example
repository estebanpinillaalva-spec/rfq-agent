# ============================================
# RFQ AGENT — Variables de entorno
# Copia este archivo como .env.local y rellena los valores
# NUNCA commitees .env.local a GitHub
# ============================================

# --- SUPABASE ---
# Obten estos valores en: supabase.com → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- RESEND ---
# Obten en: resend.com → API Keys
# Para inbound/Receiving necesita acceso completo o permisos para leer emails recibidos y adjuntos.
# Una key solo de envio producira: "This API key is restricted to only send emails".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Secreto para validar webhooks de Resend Inbound
# Lo configuras al crear el endpoint de inbound en Resend
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# Tu dominio verificado en Resend (ej: rfq.tudominio.com)
RESEND_FROM_DOMAIN=rfq.tudominio.com
# Puente local email -> piloto. Usa "mock" para pruebas sin coste o "gemini" para IA real.
RFQ_INBOUND_PROVIDER=mock
# Opcional: config de taller a usar para RFQs recibidos por email.
# Si se omite, usa rfq-agent-piloto/ejemplos/rfq-simple/config-taller.json
RFQ_INBOUND_CONFIG_PATH=
# Solo para pruebas manuales locales sin firma Svix. Nunca en produccion.
ALLOW_UNVERIFIED_RESEND_WEBHOOKS=false

# --- ANTHROPIC (Claude) ---
# Obten en: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- GOOGLE GEMINI ---
# Obten en: aistudio.google.com → Get API key
GOOGLE_GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx

# --- APP ---
# URL de tu app en producción (ej: https://rfq-agent.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto aleatorio para firmar tokens internos
# Genera uno con: openssl rand -base64 32
INTERNAL_SECRET=cambia_esto_por_algo_aleatorio_seguro
